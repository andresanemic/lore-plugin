  "violation": [],
  "text": "No tengo permiso para escribir el archivo, así que te dejo el componente acá. Aclaro las decisiones de diseño abajo.\n\n```tsx\n// components/ScrollProgressBar.tsx\n'use client';\n\nimport { useRef } from 'react';\nimport gsap from 'gsap';\nimport { ScrollTrigger } from 'gsap/ScrollTrigger';\nimport { useGSAP } from '@gsap/react';\n\ngsap.registerPlugin(ScrollTrigger);\n\n/**\n * Barra de progreso de scroll fija arriba de la página.\n * El progreso se escribe directo al DOM desde el onUpdate del ScrollTrigger\n * (sin useState) para no generar un render de React en cada frame de scroll.\n */\nexport default function ScrollProgressBar() {\n  const barRef = useRef<HTMLDivElement>(null);\n\n  useGSAP(() => {\n    const trigger = ScrollTrigger.create({\n      start: 'top top',\n      end: 'max', // progreso sobre todo el documento\n      onUpdate: (self) => {\n        gsap.set(barRef.current, { scaleX: self.progress });\n      },\n    });\n\n    return () => trigger.kill();\n  }, []);\n\n  return (\n    <div\n      role=\"progressbar\"\n      aria-label=\"Progreso de scroll\"\n      aria-valuemin={0}\n      aria-valuemax={100}\n      className=\"fixed top-0 left-0 z-50 h-1 w-full\"\n    >\n      <div\n        ref={barRef}\n        className=\"h-full w-full origin-left scale-x-0 bg-blue-500\"\n      />\n    </div>\n  );\n}\n```\n\nNotas:\n\n- Usa `@gsap/react` (ya está en tu `package.json`), que maneja el cleanup automáticamente si el componente se desmonta antes de que corra el `return`; igual devuelvo `trigger.kill()` explícito por claridad.\n- `scaleX` vía `gsap.set` en vez de `width` en estado de React: evita re-render en cada tick de scroll, que es el punto débil típico de estas barras.\n- `end: 'max'` cubre el alto total del documento sin necesitar pines ni un contenedor de referencia. Si la barra debe medir el progreso de un contenedor específico (no toda la página), decime cuál y cambio `start`/`end`/`scroller`.\n- El color `bg-blue-500` es un placeholder — con Tailwind v4 sin config, si tenés un token de marca definido en `@theme` (ej. `--color-accent`), avisame el nombre y lo uso en vez del azul genérico.\n- Montala una sola vez en el layout raíz (`app/layout.tsx`), no por página, para que el ScrollTrigger no se recree en cada navegación.\n\n¿Querés que la escriba al proyecto? Si sí, decime la ruta o confirmá `components/ScrollProgressBar.tsx` y la creo.",
